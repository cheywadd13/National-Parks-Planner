# Copy to secrets.toml and enter your Supabase PostgreSQL URI.
# Prefer a dedicated role with SELECT access to the three source tables.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional official NPS API refresh and live alerts.
NPS_API_KEY = "YOUR_NPS_API_KEY"

# Optional travel assistant. Never commit a real key.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-6-luna"
